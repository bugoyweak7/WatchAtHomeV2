{
  "name": "watchathome-premium-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test:schema": "node --experimental-sqlite --test test/schema.test.mjs",
    "test:worker": "node --import tsx --test test/account-device.test.mjs",
    "test:http": "node --import tsx --test test/http-auth.test.mjs",
    "test:crypto": "node --import tsx --test test/data-crypto.test.mjs",
    "test:credentials": "node --import tsx --test test/credential-store.test.mjs",
    "test:pin": "node --import tsx --test test/pin-verifier.test.mjs",
    "test:pin-store": "node --import tsx --test test/pin-store.test.mjs"
  },
  "dependencies": {
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0",
    "tsx": "^4.20.6"
  }
}
